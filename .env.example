# sidecarmaster. Copy to .env (local) or sidecarmaster.env (Docker). Never commit real values.
DATABASE_URL=file:./data/sidecarmaster.db
# First admin. Used only when the AdminUser table is empty.
SM_ADMIN_USERNAME=admin
SM_ADMIN_PASSWORD=
# 32+ random characters. Encrypts stored secrets (SMTP password). Do not change after first use.
SM_SECRET_KEY=
# Folder shared with the NetBird and Caddy containers.
NETBIRD_CTL_DIR=/netbird-ctl
# Set to 1 only when the site is served over https (cookie Secure flag).
SM_SECURE_COOKIES=0
